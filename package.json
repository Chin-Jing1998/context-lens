{
  "name": "context-lens",
  "version": "0.10.0",
  "description": "Context and usage HUD maintained by Chin-Jing1998, derived from Claude HUD",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "context-lens": "scripts/context-lens.mjs" },
  "files": [
    "dist/",
    "src/",
    "commands/",
    "scripts/clean-dist.mjs",
    "scripts/setup.mjs",
    "scripts/statusline.mjs",
    "scripts/context-lens.mjs",
    "scripts/build-desktop.mjs",
    "desktop/ContextLens.swift",
    "web/",
    "docs/",
    ".claude-plugin/"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=lcov node --test",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 npm test",
    "test:stdin": "npm run build && echo '{\"model\":{\"display_name\":\"Opus\"},\"context_window\":{\"current_usage\":{\"input_tokens\":45000},\"context_window_size\":200000},\"transcript_path\":\"/tmp/test.jsonl\"}' | node dist/index.js"
  },
  "keywords": [
    "claude-code",
    "statusline",
    "hud"
  ],
  "author": "Jarrod Watts",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "c8": "^11.0.0",
    "typescript": "^7.0.2"
  },
  "contributors": [
    {
      "name": "Chin-Jing1998",
      "url": "https://github.com/Chin-Jing1998"
    }
  ],
  "homepage": "https://github.com/Chin-Jing1998/context-lens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chin-Jing1998/context-lens.git"
  },
  "bugs": {
    "url": "https://github.com/Chin-Jing1998/context-lens/issues"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21",
    "smol-toml": "^1.9.0"
  }
}
